# ============ LLM(回答生成)============
# OpenAI 兼容 /chat/completions 端点
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
MAX_ITER=8

# ============ 向量化(索引与检索)============
# 阿里云百炼 DashScope,OpenAI 兼容端点,qwen3.7-text-embedding
DASHSCOPE_API_KEY=
# EMBED_MODEL=qwen3.7-text-embedding
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings

